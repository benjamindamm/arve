<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="Accordion" initial="control">
  <datamodel>
    <data id="controlled" expr="false" />
    <data id="disabled" expr="false" />
    <data id="value" expr="[]" />
    <data id="candidate" expr="[]" />
    <data id="multiple" expr="false" />
    <data id="itemValues" expr="['alpha','beta']" />
    <data id="disabledItems" expr="[]" />
    <data id="focusedItem" expr="null" />
  </datamodel>
  <state id="control" initial="ready">
    <transition event="SET_CONTROLLED" cond="typeof _event.data.controlled === 'boolean'">
      <assign location="controlled" expr="_event.data.controlled" />
    </transition>
    <transition event="SET_DISABLED" cond="typeof _event.data.disabled === 'boolean'">
      <assign location="disabled" expr="_event.data.disabled" />
    </transition>
    <state id="ready">
      <transition event="SET_VALUE" cond="Array.isArray(_event.data.value)">
        <assign location="value" expr="_event.data.value" />
      </transition>
      <transition event="SET_ITEMS" cond="Array.isArray(_event.data.itemValues)">
        <assign location="itemValues" expr="_event.data.itemValues" />
      </transition>
      <transition event="SET_DISABLED_ITEMS" cond="Array.isArray(_event.data.disabledItems)">
        <assign location="disabledItems" expr="_event.data.disabledItems" />
      </transition>
      <transition event="SET_MULTIPLE" cond="typeof _event.data.multiple === 'boolean'">
        <assign location="multiple" expr="_event.data.multiple" />
      </transition>
      <transition event="TRIGGER_PRESS" cond="!disabled &amp;&amp; itemValues.includes(_event.data.item) &amp;&amp; !disabledItems.includes(_event.data.item) &amp;&amp; !!_event.data.eventDetails">
        <assign location="candidate" expr="value.includes(_event.data.item) ? value.filter(item =&gt; item !== _event.data.item) : (multiple ? value.concat([_event.data.item]) : [_event.data.item])" />
        <send event="onValueChange" target="#_parent">
          <param name="value" expr="candidate" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <if cond="!controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
          <assign location="value" expr="candidate" />
        </if>
      </transition>
      <transition event="FOCUS_IN" cond="itemValues.includes(_event.data.item)">
        <assign location="focusedItem" expr="_event.data.item" />
      </transition>
      <transition event="ESCAPE ARROW_UP ARROW_DOWN HOME END FOCUS_OUT" />
    </state>
  </state>
</scxml>
