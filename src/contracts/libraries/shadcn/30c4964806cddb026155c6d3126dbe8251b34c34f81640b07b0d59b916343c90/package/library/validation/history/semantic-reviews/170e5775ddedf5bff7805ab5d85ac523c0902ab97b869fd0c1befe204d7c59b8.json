    "runtimeProperties": {},
    "layoutPolicy": "Textarea is the actual native textarea export. Native 64px minimum height, 8/10px padding and 10px corners become semantic roles; the 360px sample width does not become a runtime constraint. Source field-sizing-content is represented directly, with a minimum-height fallback and native vertical resizing. Content can grow instead of clipping to a specimen height. Native label/help/error IDs are caller decisions, while readOnly, disabled, multiline value/selection/IME and native events remain browser-owned. Readonly stays focusable and selectable; disabled prevents user edits and is skipped in Tab order. Invalid styling supplements a linked readable error and does not invent validation.",
    "variants": {
      "disabled": {
        "prop": "disabled",
        "nativeAttribute": "disabled"
      },
      "readOnly": {
        "prop": "readOnly",
        "nativeAttribute": "readonly"
      },
      "invalid": {
        "nativeAttribute": "aria-invalid",
        "callerValidation": true
      }
    },
    "sourceTraceability": "figma/traceability.json"
  }
