        "attribute": "data-align",
        "values": [
          "start",
          "end"
        ]
      },
      "reactionSide": {
        "declaration": "BubbleReactions",
        "prop": "side",
        "attribute": "data-side",
        "values": [
          "top",
          "bottom"
        ]
      },
      "reactionAlign": {
        "declaration": "BubbleReactions",
        "prop": "align",
        "attribute": "data-align",
        "values": [
          "start",
          "end"
        ]
      }
    },
    "sourceTraceability": "figma/traceability.json"
