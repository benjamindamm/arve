<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="Input" initial="control"><datamodel><data id="value" expr="''"/><data id="readOnly" expr="false"/><data id="controlled" expr="false"/></datamodel><state id="control" initial="enabled"><transition event="FOCUS_IN FOCUS_OUT"/><transition event="ESCAPE"/><transition event="SET_VALUE" cond="_event.data &amp;&amp; (typeof _event.data.value === 'string' || typeof _event.data.value === 'number')"><assign location="value" expr="String(_event.data.value)"/></transition><transition event="SET_READONLY" cond="_event.data &amp;&amp; typeof _event.data.readOnly === 'boolean'"><assign location="readOnly" expr="_event.data.readOnly"/></transition><transition event="SET_CONTROLLED" cond="_event.data &amp;&amp; typeof _event.data.controlled === 'boolean'"><assign location="controlled" expr="_event.data.controlled"/></transition><state id="enabled"><transition event="DISABLE" target="disabled"/><transition event="NATIVE_INPUT" cond="!readOnly &amp;&amp; _event.data &amp;&amp; typeof _event.data.value === 'string'"><send event="onChange" target="#_parent"><param name="value" expr="_event.data.value"/></send><if cond="!controlled"><assign location="value" expr="_event.data.value"/></if></transition></state><state id="disabled"><transition event="ENABLE" target="enabled"/></state></state></scxml>
