<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="Command" initial="active">
  <datamodel>
    <data id="value" expr="''" />
    <data id="valueControlled" expr="false" />
    <data id="query" expr="''" />
    <data id="queryControlled" expr="false" />
    <data id="highlighted" expr="null" />
    <data id="disabledItems" expr="['unavailable']" />
    <data id="dialogOpen" expr="false" />
    <data id="dialogOpenControlled" expr="false" />
  </datamodel>
  <state id="active">
    <transition event="SET_VALUE">
      <assign location="value" expr="_event.data.value" />
    </transition>
    <transition event="SET_QUERY">
      <assign location="query" expr="_event.data.query" />
    </transition>
    <transition event="SET_VALUE_CONTROLLED">
      <assign location="valueControlled" expr="_event.data.valueControlled" />
    </transition>
    <transition event="SET_QUERY_CONTROLLED">
      <assign location="queryControlled" expr="_event.data.queryControlled" />
    </transition>
    <transition event="SET_DISABLED_ITEMS">
      <assign location="disabledItems" expr="_event.data.disabledItems" />
    </transition>
    <transition event="SET_DIALOG_OPEN">
      <assign location="dialogOpen" expr="_event.data.dialogOpen" />
    </transition>
    <transition event="SET_DIALOG_OPEN_CONTROLLED">
      <assign location="dialogOpenControlled" expr="_event.data.dialogOpenControlled" />
    </transition>
    <transition event="TAB SHIFT_TAB ARROW_UP ARROW_DOWN HOME END FOCUS_IN FOCUS_OUT" />
    <transition event="ESCAPE" cond="dialogOpen">
      <send event="_effect.delegateDialogEscape" target="#_parent">
        <param name="policy" expr="'composed-Dialog-callback-cancellation-and-focus-contract'" />
      </send>
    </transition>
    <transition event="ESCAPE" cond="!dialogOpen" />
    <transition event="SOURCE_HIGHLIGHT" cond="typeof _event.data.value === 'string' &amp;&amp; !disabledItems.includes(_event.data.value)">
      <assign location="highlighted" expr="_event.data.value" />
      <if cond="valueControlled">
        <send event="onValueChange" target="#_parent">
          <param name="value" expr="_event.data.value" />
        </send>
        <else />
        <assign location="value" expr="_event.data.value" />
      </if>
    </transition>
    <transition event="SOURCE_QUERY_CHANGE" cond="typeof _event.data.value === 'string'">
      <send event="onValueChange" target="#_parent">
        <param name="value" expr="_event.data.value" />
      </send>
      <if cond="!queryControlled">
        <assign location="query" expr="_event.data.value" />
      </if>
    </transition>
    <transition event="SOURCE_ITEM_SELECT" cond="typeof _event.data.value === 'string' &amp;&amp; !disabledItems.includes(_event.data.value)">
      <send event="onSelect" target="#_parent">
        <param name="value" expr="_event.data.value" />
      </send>
    </transition>
    <transition event="SOURCE_DIALOG_OPEN_CHANGE" cond="!!_event.data.eventDetails">
      <send event="onOpenChange" target="#_parent">
        <param name="open" expr="_event.data.open" />
        <param name="eventDetails" expr="_event.data.eventDetails" />
      </send>
      <if cond="!dialogOpenControlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <assign location="dialogOpen" expr="_event.data.open" />
      </if>
    </transition>
  </state>
</scxml>
