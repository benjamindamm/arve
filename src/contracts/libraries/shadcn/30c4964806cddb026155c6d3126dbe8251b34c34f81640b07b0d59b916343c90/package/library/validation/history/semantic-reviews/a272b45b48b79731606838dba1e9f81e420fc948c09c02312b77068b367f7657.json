    "runtimeProperties": {},
    "layoutPolicy": "Card keeps intrinsic content height, fluid width,16px section spacing/insets and14px native corners. Native header/footer sample widths are not fixed runtime dimensions. The seven actual exported wrappers own distinct semantic parts. Native typography varies across specimens; the reference selects the observed16/24px medium title and14/20px body, with native headings explicitly supplied by the caller. The public sm size has no identified native sm master:12px section gap and14/20px title are an explicit compact reference choice, not a fabricated observation. RTL uses logical layout; footer actions wrap. No Card-specific activation event is invented.",
    "variants": {
      "size": {
        "prop": "size",
        "attribute": "data-size",
        "values": [
          "default",
          "sm"
        ]
      },
      "direction": {
        "prop": "dir",
        "values": [
          "ltr",
          "rtl"
        ]
      }
    },
    "sourceTraceability": "figma/traceability.json"
  }
