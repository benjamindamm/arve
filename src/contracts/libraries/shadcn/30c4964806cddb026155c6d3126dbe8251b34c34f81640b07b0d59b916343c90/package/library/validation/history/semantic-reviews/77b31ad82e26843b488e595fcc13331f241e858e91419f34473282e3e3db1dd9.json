    "runtimeProperties": {},
    "layoutPolicy": "Item maps all ten actual exports, with native 10/12px normal padding, 8/10px extra-small padding, 10px outer gap, 4px content gap, 10px corners, 40px/6px image geometry and 20px optional glyph. The source API additionally supports sm; an explicit 8px block/12px inline reference choice fills that size without claiming an unobserved native master. Three actual variant classes and three size classes bind presentation. Native sample width and fractional height are not hardcoded; text can wrap rather than clipping necessary information. ItemGroup supplies role=list but Item itself does not automatically supply listitem semantics: the caller does so for these default div rows. A whole-row native anchor fixture remains outside the list, has a real destination and omits nested actions. Default row actions are separate Buttons. ItemSeparator remains the composed nonfocusable horizontal separator and is hidden when merely decorative.",
    "variants": {
      "variant": {
        "prop": "variant",
        "classes": [
          "cn-item-variant-default",
          "cn-item-variant-outline",
          "cn-item-variant-muted"
        ]
      },
      "size": {
        "prop": "size",
        "classes": [
          "cn-item-size-default",
          "cn-item-size-sm",
          "cn-item-size-xs"
        ]
      },
      "media": {
        "declaration": "ItemMedia",
        "prop": "variant",
        "attribute": "data-variant",
        "values": [
          "default",
          "icon",
          "image"
        ]
      }
    },
    "sourceTraceability": "figma/traceability.json"
  }
