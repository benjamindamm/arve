<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="Tooltip" initial="control">
  <datamodel>
    <data id="controlled" expr="false" />
    <data id="disabled" expr="false" />
    <data id="open" expr="false" />
    <data id="preventUnmount" expr="false" />
    <data id="modal" expr="false" />
    <data id="disablePointerDismissal" expr="false" />
  </datamodel>
  <state id="control" initial="closed">
    <transition event="SET_CONTROLLED" cond="typeof _event.data.controlled === 'boolean'">
      <assign location="controlled" expr="_event.data.controlled" />
    </transition>
    <transition event="SET_DISABLED" cond="typeof _event.data.disabled === 'boolean'">
      <assign location="disabled" expr="_event.data.disabled" />
    </transition>
    <state id="closed">
      <transition event="POINTER_ENTER" target="waiting" cond="!disabled" />
      <transition event="FOCUS_IN" cond="(!disabled) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="true" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="FOCUS_IN" target="opening" cond="(!disabled) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="true" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="true" />
      </transition>
    </state>
    <state id="opening">
      <transition event="ESCAPE" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="ESCAPE" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
      <transition event="OUTSIDE_PRESS" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="OUTSIDE_PRESS" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
      <transition event="HOVER_REGION_LEFT" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="HOVER_REGION_LEFT" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
      <transition event="FOCUS_OUT" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="FOCUS_OUT" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
      <transition event="TRIGGER_PRESS" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="TRIGGER_PRESS" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
      <transition event="ANIMATION_COMPLETE" target="expanded" cond="_event.data.open === true">
        <send event="onOpenChangeComplete" target="#_parent">
          <param name="open" expr="true" />
        </send>
      </transition>
    </state>
    <state id="expanded">
      <transition event="ESCAPE" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="ESCAPE" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
      <transition event="OUTSIDE_PRESS" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="OUTSIDE_PRESS" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
      <transition event="HOVER_REGION_LEFT" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="HOVER_REGION_LEFT" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
      <transition event="FOCUS_OUT" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="FOCUS_OUT" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
      <transition event="TRIGGER_PRESS" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="TRIGGER_PRESS" target="closing" cond="(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="false" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="false" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </transition>
    </state>
    <state id="closing">
      <transition event="ANIMATION_COMPLETE" target="closed" cond="_event.data.open === false &amp;&amp; !preventUnmount">
        <send event="onOpenChangeComplete" target="#_parent">
          <param name="open" expr="false" />
        </send>
      </transition>
      <transition event="UNMOUNT_ACTION" target="closed" cond="true">
        <send event="onOpenChangeComplete" target="#_parent">
          <param name="open" expr="false" />
        </send>
      </transition>
    </state>
    <transition event="SET_OPEN" target="closing" cond="typeof _event.data.open === 'boolean' &amp;&amp; _event.data.open === false &amp;&amp; open !== _event.data.open">
      <assign location="open" expr="false" />
      <assign location="preventUnmount" expr="false" />
    </transition>
    <transition event="SET_OPEN" target="opening" cond="typeof _event.data.open === 'boolean' &amp;&amp; _event.data.open === true &amp;&amp; open !== _event.data.open">
      <assign location="open" expr="true" />
      <assign location="preventUnmount" expr="false" />
    </transition>
    <state id="waiting">
      <transition event="POINTER_LEAVE FOCUS_OUT ESCAPE" target="closed" />
      <transition event="OPEN_DELAY_ELAPSED" cond="(!disabled) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="true" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
      </transition>
      <transition event="OPEN_DELAY_ELAPSED" target="opening" cond="(!disabled) &amp;&amp; !!_event.data.eventDetails &amp;&amp; !controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <send event="onOpenChange" target="#_parent">
          <param name="open" expr="true" />
          <param name="eventDetails" expr="_event.data.eventDetails" />
        </send>
        <assign location="open" expr="true" />
      </transition>
    </state>
    <transition event="FOCUS_SETTLED" />
  </state>
</scxml>
