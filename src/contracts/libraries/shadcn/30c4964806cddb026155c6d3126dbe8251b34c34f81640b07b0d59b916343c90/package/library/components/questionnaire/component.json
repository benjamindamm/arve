    "runtimeProperties": {},
    "layoutPolicy": "Every actual exported form wrapper and private native Choice subpart has stable slot identity. Native 64px minimum answer card,10px corner,16px indicator/8px dot and 20px shortcut role remain semantic tokens; preferred 448px form width is capped by its parent and answers grow for longer text. Radio/checkbox decoration follows actual data-type/data-checked; invisible native input still owns focus, labels, selection and FormData. Focus-visible is projected on the actual containing label, not an invented role. Inactive Item and inapplicable action hidden/inert states remain hidden despite flex/grid layout; errors use actual registered alert/description semantics. Source-independent fixtures include required/optional, single/multiple, text/error and focus. Source active item, native answers, skip participation and submission validity are separate authorities. Source Ctrl/Meta+Enter and optional letter shortcuts remain real primitive behavior, never generic value transitions. Preferred spacing/type sizes and 44px form actions are explicit readable reference decisions. No page coordinates, source ID anatomy or hidden native answer replacement.",
    "variants": {
      "type": {
        "source": "QuestionnaireItem.multiple",
        "attribute": "data-type=radio|checkbox"
      },
      "answer": {
        "source": "native answer state",
        "attributes": [
          "data-checked",
          "data-unchecked",
          "data-disabled"
        ]
      },
      "active": {
        "source": "item context",
        "attributes": [
          "data-active",
          "hidden",
          "inert"
        ]
      },
      "invalid": {
        "source": "source validation",
        "attribute": "aria-invalid"
      }
    },
