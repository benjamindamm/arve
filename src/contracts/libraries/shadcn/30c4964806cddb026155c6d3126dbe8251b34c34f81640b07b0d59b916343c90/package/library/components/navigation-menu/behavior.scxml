<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="NavigationMenu" initial="active">
  <datamodel>
    <data id="value" expr="null" />
    <data id="controlled" expr="false" />
    <data id="phase" expr="'closed'" />
    <data id="preventUnmount" expr="false" />
    <data id="disabledItems" expr="['unavailable']" />
  </datamodel>
  <state id="active">
    <transition event="SET_CONTROLLED">
      <assign location="controlled" expr="_event.data.controlled" />
    </transition>
    <transition event="SET_DISABLED_ITEMS">
      <assign location="disabledItems" expr="_event.data.disabledItems" />
    </transition>
    <transition event="SET_VALUE">
      <assign location="value" expr="_event.data.value" />
      <assign location="phase" expr="value == null ? 'closing' : 'open'" />
    </transition>
    <transition event="SOURCE_VALUE_CHANGE" cond="!!_event.data.eventDetails &amp;&amp; (_event.data.value == null || !disabledItems.includes(_event.data.value))">
      <send event="onValueChange" target="#_parent">
        <param name="value" expr="_event.data.value" />
        <param name="eventDetails" expr="_event.data.eventDetails" />
      </send>
      <if cond="!controlled &amp;&amp; !_event.data.eventDetails.isCanceled">
        <assign location="value" expr="_event.data.value" />
        <assign location="phase" expr="value == null ? 'closing' : 'open'" />
        <assign location="preventUnmount" expr="!!_event.data.preventUnmount" />
      </if>
    </transition>
    <transition event="SOURCE_CLOSED_COMPLETE" cond="value == null &amp;&amp; !preventUnmount">
      <assign location="phase" expr="'closed'" />
      <assign location="preventUnmount" expr="false" />
      <send event="onOpenChangeComplete" target="#_parent">
        <param name="open" expr="false" />
      </send>
    </transition>
    <transition event="UNMOUNT_ACTION" cond="value == null &amp;&amp; preventUnmount">
      <assign location="phase" expr="'closed'" />
      <assign location="preventUnmount" expr="false" />
      <send event="onOpenChangeComplete" target="#_parent">
        <param name="open" expr="false" />
      </send>
    </transition>
    <transition event="ESCAPE" cond="value != null">
      <send event="_effect.sourceDismissRequest" target="#_parent">
        <param name="reason" expr="'escape-key'" />
      </send>
    </transition>
    <transition event="HOVER_INTENT">
      <send event="_effect.sourceHoverDelay" target="#_parent">
        <param name="milliseconds" expr="50" />
      </send>
    </transition>
    <transition event="ARROW_LEFT ARROW_RIGHT ARROW_UP ARROW_DOWN TAB SHIFT_TAB FOCUS_IN FOCUS_OUT" />
    <transition event="NATIVE_LINK_CLICK" cond="!!_event.data.href &amp;&amp; !!_event.data.event">
      <send event="onClick" target="#_parent">
        <param name="event" expr="_event.data.event" />
      </send>
      <if cond="!_event.data.event.defaultPrevented">
        <send event="_effect.nativeNavigation" target="#_parent">
          <param name="href" expr="_event.data.href" />
        </send>
      </if>
    </transition>
  </state>
</scxml>
