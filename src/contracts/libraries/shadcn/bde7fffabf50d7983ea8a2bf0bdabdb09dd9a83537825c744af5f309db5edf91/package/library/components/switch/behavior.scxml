<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="Switch" initial="control"><datamodel><data id="checked" expr="false"/><data id="readOnly" expr="false"/><data id="controlled" expr="false"/></datamodel><state id="control" initial="enabled"><transition event="FOCUS_IN FOCUS_OUT"/><transition event="ESCAPE"/><transition event="SET_CHECKED" cond="_event.data &amp;&amp; typeof _event.data.checked === 'boolean'"><assign location="checked" expr="_event.data.checked"/></transition><transition event="SET_READONLY" cond="_event.data &amp;&amp; typeof _event.data.readOnly === 'boolean'"><assign location="readOnly" expr="_event.data.readOnly"/></transition><transition event="SET_CONTROLLED" cond="_event.data &amp;&amp; typeof _event.data.controlled === 'boolean'"><assign location="controlled" expr="_event.data.controlled"/></transition><state id="enabled"><transition event="DISABLE" target="disabled"/><transition event="CHECKED_CHANGE" cond="!readOnly &amp;&amp; _event.data &amp;&amp; typeof _event.data.checked === 'boolean' &amp;&amp; checked !== _event.data.checked"><send event="onCheckedChange" target="#_parent"><param name="checked" expr="_event.data.checked"/></send><if cond="!controlled &amp;&amp; !_event.data.isCanceled"><assign location="checked" expr="_event.data.checked"/></if></transition></state><state id="disabled"><transition event="ENABLE" target="enabled"/></state></state></scxml>
