{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "seed:system": "node scripts/seed-system.mjs",
    "build:static": "node scripts/build-static-site.mjs",
    "check:static": "node --import tsx scripts/check-static-site.ts",
    "preview:static": "node scripts/serve-static-site.mjs",
    "check:component-template": "node --import tsx scripts/check-component-template.ts",
    "check:component-catalog": "node --import tsx scripts/check-component-catalog.ts --all --published --report",
    "check:mcp:unit": "node --import tsx scripts/mcp-reads.test.ts && node --import tsx scripts/mcp-library-skills.test.ts && node --import tsx --test src/docs/documentation-search.test.ts src/docs/mcp-navigation.test.ts",
    "reference:export": "node --import tsx scripts/system-template.ts export",
    "reference:import": "node --env-file-if-exists=.env --import tsx scripts/system-template.ts import",
    "reference:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-reference.ts",
    "predev": "npm run reference:setup && npm run build:mcp-apps",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "prestart": "npm run reference:setup",
    "check:reference": "node --import tsx --test scripts/system-template.test.ts",
    "reference:capture": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-handbook-export.ts",
    "check:reference:db": "node --env-file=.env --import tsx scripts/system-template.integration.ts",
    "check:handbook-paths": "node --import tsx --test scripts/handbook-paths.test.ts",
    "db:editorial": "node --env-file-if-exists=.env --import tsx scripts/add-editorial-fields.ts",
    "build:mcp-apps": "node scripts/build-mcp-apps.mjs",
    "prebuild": "npm run build:mcp-apps",
    "prebuild:static": "npm run build:mcp-apps",
    "check:agent-ui": "node --import tsx --test scripts/agent-ui.test.ts",
    "preview:agent-ui": "npm run build:mcp-apps && node --import tsx scripts/agent-ui-host.ts",
    "db:publishing": "node --env-file-if-exists=.env --import tsx scripts/migrate-publishing.ts",
    "check:publishing:db": "node --env-file-if-exists=.env --import tsx scripts/publication.integration.ts",
    "check:publishing:migration": "node --env-file-if-exists=.env --import tsx scripts/publishing-migration.integration.ts",
    "db:home-template": "node --env-file-if-exists=.env --import tsx scripts/migrate-home-template.ts",
    "check:home-template": "node --import tsx --test scripts/system-home.test.ts",
    "check:home-template:db": "node --env-file-if-exists=.env --import tsx scripts/home-template.integration.ts",
    "contracts:import": "node --import tsx scripts/contracts.ts",
    "db:contract-bindings": "node --env-file-if-exists=.env --import tsx scripts/migrate-contract-bindings.ts",
    "check:connector": "node --test scripts/import-contract-library.test.mjs scripts/contract-registry.test.mjs && node --import tsx --test scripts/mcp-library-skills.test.ts",
    "check:connector:db": "node --env-file-if-exists=.env --import tsx scripts/contract-connector.integration.ts",
    "build:mcp": "node packages/arve-mcp/build.mjs",
    "pack:mcp": "npm pack ./packages/arve-mcp --pack-destination .runtime",
    "check:mcp:static": "node --import tsx scripts/static-mcp.integration.ts",
    "db:external-links": "node --env-file-if-exists=.env --import tsx scripts/migrate-external-links.ts",
    "check:external-links:db": "node --env-file-if-exists=.env --import tsx scripts/external-links.integration.ts"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@spartan-ng/brain": "1.9.0",
    "graphql": "^16.11.0",
    "highlight.js": "11.12.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "pdf-lib": "1.17.1",
    "postcss": "8.5.23",
    "postcss-value-parser": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.25.12",
    "parse5": "8.1.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
