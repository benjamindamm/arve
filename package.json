{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "seed:system": "node scripts/seed-system.mjs",
    "build:static": "node scripts/build-static-site.mjs",
    "check:static": "node --import tsx scripts/check-static-site.ts",
    "preview:static": "node scripts/serve-static-site.mjs",
    "check:component-template": "node --import tsx scripts/check-component-template.ts",
    "check:component-catalog": "node --import tsx scripts/check-component-catalog.ts --all --published --report"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@spartan-ng/brain": "1.9.0",
    "graphql": "^16.11.0",
    "highlight.js": "11.12.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "pdf-lib": "1.17.1",
    "postcss": "8.5.23",
    "postcss-value-parser": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "parse5": "8.1.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
