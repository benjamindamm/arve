{
  "tools": [
    {
      "name": "list_documentation_tree",
      "description": "List the published documentation hierarchy for a design system, including layout examples and components.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          }
        },
        "required": [
          "system"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "search_documentation",
      "description": "Search published documentation titles and text. Use get_documentation_page for sections and layout examples, or get_component_page for components.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [
          "system",
          "query"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_documentation_page",
      "description": "Read a published section or a layout example. To retrieve a layout example, pass section \"layout\" and the example slug.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "section": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "example": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          }
        },
        "required": [
          "system",
          "section"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_component_page",
      "description": "Read a published design-system component page and its pinned technical contract.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "component": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          }
        },
        "required": [
          "system",
          "component"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}
