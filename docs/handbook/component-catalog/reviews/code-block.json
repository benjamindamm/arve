      ]
    },
    {
      "id": "example-editorial",
      "blockName": "example",
      "kind": "editorial",
      "statement": "Die deutschsprachige JSON-Konfiguration ist ein eigener statischer Entwurf, keine behauptete Demo."
    },
    {
      "id": "anatomy-parts",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Kopf, Titel, Aktionen, Inhalt und Fuss sind belegte Teile; der Titel ist keine automatische Überschrift.",
