  "claims": [
    {
      "id": "usage-purpose",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Auswählbarer Code mit unabhängiger Kopieraktion; kein eingebauter Editor oder Highlighter.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/code-block/ux.json",
          "pointer": "/sourceRule"
        }
      ]
    },
    {
      "id": "usage-alternatives",
      "blockName": "usage",
      "kind": "editorial",
      "statement": "Textarea für Bearbeitung und kurze Codeauszeichnung für einzelne Namen sind redaktionelle Auswahlhilfen."
    },
    {
      "id": "example-copy-value",
      "blockName": "example",
      "kind": "contract",
      "statement": "Der Kopiertext wird separat und exakt übergeben, nicht aus der nummerierten Anzeige gewonnen.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/code-block/interface.json",
          "pointer": "/modules/0/declarations/4/members/0"
