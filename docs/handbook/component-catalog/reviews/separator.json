  "decisions": [
    "Dekorative und bedeutungstragende Trennung getrennt von der Orientierung erklärt; kein unbelegtes decorative-Prop angeboten.",
    "Passive Zustände knapp behandelt; keine Hover-, Lade- oder Auswahlzustände erfunden.",
    "Die Illustration zeigt nur den horizontalen Einsatz, die belegte vertikale Option ist im Text erläutert."
  ],
  "limits": [
    "Keine lokale Separator-Demo vorhanden.",
    "Die statische Illustration belegt weder Rendering noch Tastatur- oder Assistenztechnikverhalten einer Anwendung."
