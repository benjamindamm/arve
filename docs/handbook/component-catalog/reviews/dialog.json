    {
      "id": "dialog-cancel",
      "blockName": "states",
      "kind": "contract",
      "statement": "Eine Schliessanforderung mit Abbruch oder kontrolliertem Zustand sendet onOpenChange ohne selbständigen Wechsel nach closing.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dialog/behavior.scxml",
          "snippet": "<transition event=\"CLOSE_PRESS\" cond=\"(true) &amp;&amp; !!_event.data.eventDetails &amp;&amp; (controlled || _event.data.eventDetails.isCanceled)\">"
        }
      ]
    },
    {
