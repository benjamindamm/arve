  "claims": [
    {
      "id": "dialog-purpose",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Dialog dient einer fokussierten Aufgabe; verschachtelte Modals brauchen eine ausdrückliche Fokusstrategie.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dialog/ux.json",
          "pointer": "/purpose"
        }
      ]
    },
    {
      "id": "dialog-choice",
      "blockName": "usage",
      "kind": "editorial",
      "statement": "Für lange Abläufe wird eine eigene Seite, für folgenschwere Bestätigungen Alert Dialog empfohlen."
    },
    {
      "id": "dialog-example",
      "blockName": "example",
      "kind": "editorial",
      "statement": "Projekt umbenennen ist ein redaktioneller Entwurf; Validierung, Speichern und Entwurfsverwaltung gehören zur Anwendung."
    },
    {
      "id": "dialog-layout",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Die Fläche ist zentriert und scrollbar, der Fussbereich behält die Inhaltsreihenfolge und kann umbrechen.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dialog/layout.css",
          "snippet": "max-block-size: calc(100dvh - 32px);\n  overflow: auto;"
        }
      ]
    },
    {
      "id": "dialog-footer",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Der Fussbereich des Referenzlayouts läuft in Zeilenrichtung und bricht um.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dialog/layout.css",
          "snippet": "flex-direction: row;\n  flex-wrap: wrap;"
        }
      ]
    },
    {
