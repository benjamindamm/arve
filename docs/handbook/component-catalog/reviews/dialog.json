    },
    {
      "id": "dialog-footer-choice",
      "blockName": "variants",
      "kind": "contract",
      "statement": "DialogFooter hat eine optionale Schliessaktion und fügt sie standardmässig nicht hinzu.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dialog/interface.json",
          "pointer": "/modules/0/declarations/7/members/0/description"
        }
      ]
    },
    {
      "id": "dialog-close-required",
      "blockName": "variants",
      "kind": "contract",
      "statement": "Bei modal=true oder trap-focus soll eine Dialog.Close-Aktion innerhalb der Fläche stehen.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/sources/base-ui-1.9.0/docs/dialog.md.source",
          "snippet": "When `modal` is `true` or `'trap-focus'`, render `<Dialog.Close>` inside `<Dialog.Popup>` so&#xA;touch screen readers can escape the popup."
        }
      ]
    },
    {
      "id": "dialog-dismissal",
      "blockName": "states",
      "kind": "contract",
      "statement": "disablePointerDismissal verhindert äusseren Druck und nichtmodalen Fokusverlust als Schliessauslöser, aber nicht explizites Close.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dialog/accessibility.rules.json",
          "pointer": "/sourceRule"
        }
      ]
