      "blockName": "keyboard",
      "kind": "contract",
      "statement": "Modaler Dialog enthält Tab/Shift+Tab, unterstützt Escape und Fokuswiederherstellung mit möglichen Überschreibungen.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dialog/accessibility.rules.json",
          "pointer": "/keyboardAndFocus"
        }
      ]
    },
    {
      "id": "dialog-initial-focus",
      "blockName": "keyboard",
      "kind": "contract",
      "statement": "Standard-Anfangsfokus ist erstes Tabziel; bei Touch wird die Fläche fokussiert.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/sources/base-ui-1.9.0/docs/dialog.md.source",
          "snippet": "By default, focus moves to the first tabbable element inside the popup, except when the dialog&#xA;is opened by touch — then the popup itself is focused to avoid opening the virtual keyboard."
        }
      ]
    },
    {
      "id": "dialog-role",
      "blockName": "semantics",
      "kind": "contract",
      "statement": "Die HTML-Projektion hat dialog-Rolle und Titel-/Beschreibungsbeziehungen.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dialog/accessibility.html",
          "snippet": "role=\"dialog\" id=\"overlay-popup\" aria-labelledby=\"overlay-title\" aria-describedby=\"overlay-description\""
        }
      ]
    },
    {
