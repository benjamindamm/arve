    {
      "id": "dialog-scope",
      "blockName": "sources",
      "kind": "contract",
      "statement": "Die Fixtures sind statisch; Verhalten und Fokus müssen im tatsächlichen Ziel geprüft werden.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dialog/stories.json",
          "pointer": "/stories/0/expectation"
        }
      ]
    }
  ],
  "decisions": [
    "Beispiel Projekt umbenennen zeigt eine konkrete kleine Bearbeitungsaufgabe mit selbst gesetzten deutschen Aktionen.",
    "Alert Dialog als redaktionelle Alternative für folgenschwere Entscheidungen benannt, ohne fremde Escape-/Fokusregeln auf Dialog zu übertragen.",
    "Anfangsfokus nach Eingabeart erklärt; kein pauschales Versprechen, dass immer das erste Feld fokussiert wird.",
    "Anwendungsaufgaben für Abbrechen, Speichern, Fehler und ungespeicherte Daten ausdrücklich vom Dialogverhalten getrennt.",
    "Englische Schliessbeschriftung der Originalvorlage als Lokalisierungsaufgabe benannt."
  ],
  "limits": [
    "Kein veröffentlichter Implementierungsnachweis für Dialog in Arve; die statischen Fixtures und das SVG belegen keinen laufenden Formularablauf.",
    "Speicherlogik, Entwurfsverlust und Fehlerbehandlung sind im Dialogcontract nicht als fertiger Anwendungsablauf definiert."
  ]
}
