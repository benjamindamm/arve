  "decisions": [
    "Eine Projektübersicht veranschaulicht inhaltliche Gruppierung; der eigenständige Link im Fuss vermeidet eine klickbare Gesamtfläche.",
    "Table und einfache Textabschnitte als redaktionelle Alternativen benannt.",
    "Die sm-Grenze ausdrücklich erklärt, ohne die kompakte Gestaltung als natives Designmuster auszugeben."
  ],
  "limits": [
    "Keine lokale Card-Demo vorhanden; die SVG ist eine statische redaktionelle Illustration.",
    "Die exportierte Bibliothek bleibt als Ganzes draft; der begrenzte Komponentenstatus complete ist keine allgemeine Produktfreigabe."
  ]
}
