  "decisions": [
    "Versandart als überschaubare feste Auswahl gewählt; SVG trennt Häkchen und Markierung sichtbar.",
    "Native Select und Radio Group als redaktionelle Alternativen markiert.",
    "Leerwert anhand gebundener Base-UI-Unterlagen präzisiert; kein automatisches Löschen durch Platzhalter versprochen.",
    "Keine Live-Demo und kein neuer Implementierungsnachweis behauptet."
  ],
  "limits": [
    "Statische redaktionelle Illustration belegt weder Laufzeitverhalten noch Pixelkonformität.",
    "Formularintegration und Hilfstechnologien müssen im konkreten Produkt geprüft werden."
  ]
