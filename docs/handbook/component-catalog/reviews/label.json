    {
      "id": "label-field-spacing",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Der optionale Feldbereich verwendet den gemeinsamen Control-Label-Abstand und keine feste Breite.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/label/layout.css",
