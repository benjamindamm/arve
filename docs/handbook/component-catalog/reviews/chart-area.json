  "claims": [
    {
      "id": "ordered-area",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Die gebundene Fläche zeigt eine geordnete monatliche Desktop-Besucherreihe; die natürliche Interpolation erzeugt keine zusätzlichen Beobachtungen.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/chart-area/ux.json",
          "pointer": "/purpose"
        }
      ]
    },
    {
      "id": "chart-choice",
      "blockName": "usage",
      "kind": "editorial",
      "statement": "Nullbasis für diese Zähldaten empfohlen; Linie für Veränderungen oder mehrere Verläufe, Balken für Monatsvergleich, Tabelle für genaue Werte."
    },
    {
      "id": "literal-data",
      "blockName": "example",
      "kind": "contract",
