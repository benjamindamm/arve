      ]
    },
    {
      "id": "small-badge",
      "blockName": "variants",
      "kind": "contract",
      "statement": "Das SVG im Abzeichen wird bei sm ausgeblendet.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/avatar/layout.css",
          "snippet": "[data-slot=\"avatar\"][data-size=\"sm\"] [data-slot=\"avatar-badge\"]>svg {\n  display: none;\n}"
        }
      ]
    },
    {
      "id": "image-lifecycle",
      "blockName": "states",
      "kind": "contract",
      "statement": "Bildzustände sind idle/loading/loaded/error; Ersatzverzögerung standardmässig 0, Quellenänderungen können Laden erneut auslösen.",
