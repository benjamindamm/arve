  "decisions": [
    "Die Variante sm wird als Dichteentscheidung empfohlen, nicht als vorgeschriebene Verwendung.",
    "Das Beispiel verwendet bewusst Initialen statt eines externen Porträts; Name und Status stehen separat.",
    "+3 wird als passive Ergänzung mit ausgeschriebener Gesamtzahl gezeigt.",
    "Die nicht interaktive Natur wird in Tastatur- und Auswahlentscheidungen erklärt."
  ],
  "limits": [
    "Keine lokale Avatar-Demo vorhanden; Illustration ist keine Laufzeitprüfung.",
    "Die Darstellung zusammengesetzter Profilaktionen wurde nicht in einer Anwendung geprüft."
  ]
}
