  "claims": [
    {
      "id": "identity-with-name",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Avatar stellt eine Person oder Entität dar und darf nicht als einzige Identitätsbeschriftung dienen.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/avatar/ux.json",
          "pointer": "/avoid"
        }
      ]
    },
    {
      "id": "example-identity-status",
      "blockName": "example",
      "kind": "editorial",
      "statement": "Das Projektbeispiel ergänzt die Initialen NK mit vollständigem Namen und lesbarem Status; die Gesamtzahl erläutert die passive +3-Fläche."
    },
    {
      "id": "anatomy-badge-group",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Abzeichen, Gruppe, Status und passive Überlaufanzahl sind getrennte Teile; Status ist Anwendungsinhalt.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/avatar/component.json",
          "pointer": "/anatomy"
        }
      ]
    },
    {
      "id": "anatomy-position",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Das Abzeichen ist physisch rechts unten positioniert, Bilder füllen den Kreis mit object-fit cover.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/avatar/layout.css",
          "snippet": "[data-slot=\"avatar-image\"] {\n  object-fit: cover;\n}"
        }
      ]
    },
    {
      "id": "actual-sizes",
      "blockName": "variants",
      "kind": "contract",
      "statement": "Nur sm/default/lg sind öffentliche Grössen; sie entsprechen 24/32/40 px. Count hat keine eigene size-API.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/avatar/component.json",
          "pointer": "/visualContract/layoutPolicy"
