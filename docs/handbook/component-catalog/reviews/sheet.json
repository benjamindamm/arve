  "decisions": [
    "Projektbearbeitung als konkretes Beispiel mit genau einem Feld; Speicherlogik ausdrücklich als Anwendungssache formuliert.",
    "Drawer als Alternative für ziehbare Flächen nur als Auswahlhinweis; keine Drawer-API auf Sheet übertragen.",
    "CSS führt den Platzbedarf und Scrollhinweis; keine pauschale Pixelkonformität der Illustration behauptet.",
    "Sichtbarer Ausstieg auch bei ausgeschaltetem internen Symbol empfohlen; Close ist im Original englisch."
  ],
  "limits": [
    "Keine lokale Sheet-Demo vorhanden.",
    "Keine Prüfung einer implementierten Sheet-Anwendung oder ihres Speicher-/Entwurfsschutzes; Illustration ist statisch."
  ]
