  "decisions": [
    "Spesenbelege als vertrauter Dokumentenkontext; gespeicherte und fehlgeschlagene Datei unterscheiden sich durch Text und dateibezogene Aktionen.",
    "Keine Fortschrittsanzeige oder Upload-Automatik erfunden.",
    "Native Tastaturkonventionen als redaktionelle Bedienhinweise eingeordnet; Contract bindet das native Element."
  ],
  "limits": [
