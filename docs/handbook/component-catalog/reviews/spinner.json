  "claims": [
    {
      "id": "usage-purpose",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Spinner zeigt laufende Arbeit; die Animation vermittelt Zweck und Abschluss nicht allein.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/ux.json",
          "pointer": "/avoid"
        }
      ]
    },
    {
      "id": "usage-alternatives",
      "blockName": "usage",
      "kind": "editorial",
      "statement": "Progress bei messbarem Anteil und Skeleton für erwartete Inhaltsanordnung sind redaktionelle Auswahlhinweise."
    },
    {
      "id": "example-copy",
      "blockName": "example",
      "kind": "editorial",
      "statement": "Das Kontaktbeispiel und sein deutscher sichtbarer Text sind ein redaktioneller Entwurf."
    },
    {
      "id": "anatomy-svg",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Ein benanntes SVG mit Rolle status ist der einzige gebundene Teil.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/component.json",
          "pointer": "/anatomy/indicator"
        }
      ]
    },
    {
      "id": "anatomy-button-position",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Die Originaldokumentation erlaubt den Spinner vor oder nach dem Buttontext.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/sources/shadcn/apps/v4/content/docs/components/base/spinner.mdx.source",
          "snippet": "Place the `<Spinner />` before the label with `data-icon=\"inline-start\"` for a start position, or after the label with `data-icon=\"inline-end\"` for an end position."
        }
      ]
    },
    {
      "id": "variants-size",
      "blockName": "variants",
      "kind": "contract",
      "statement": "16px Standard und 12/20/24px sind Caller-Klassen, kein öffentliches size-Prop.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/component.json",
          "pointer": "/visualContract/layoutPolicy"
        }
      ]
    },
    {
      "id": "variants-picker",
      "blockName": "variants",
      "kind": "contract",
      "statement": "Der Icon-Family-Picker der Registry ist ausserhalb der Komponenten-API.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/ux.json",
          "pointer": "/referenceDecision"
        }
      ]
    },
    {
      "id": "states-owner",
      "blockName": "states",
      "kind": "contract",
      "statement": "Der Aufgabenbesitzer entfernt oder ersetzt die Anzeige; Spinner startet und misst keine Aufgabe.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/ux.json",
          "pointer": "/updatesAndDescendants"
        }
      ]
    },
    {
      "id": "states-lifecycle",
      "blockName": "states",
      "kind": "contract",
      "statement": "SCXML beschreibt Darstellung, Prop-Änderung sowie Entfernen und erneutes Einbinden ohne Arbeitszustände.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/behavior.scxml",
          "snippet": "<state id=\"rendered\"><transition event=\"PROPS_CHANGED\"/><transition event=\"UNMOUNT\" target=\"removed\"/></state><state id=\"removed\"><transition event=\"MOUNT\" target=\"rendered\"/></state>"
        }
      ]
    },
    {
      "id": "states-motion",
      "blockName": "states",
      "kind": "contract",
      "statement": "Im Referenz-CSS stoppt die Animation bei prefers-reduced-motion.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/layout.css",
          "snippet": "@media (prefers-reduced-motion:reduce) {\n  [data-slot=\"spinner\"] {\n    animation: none;\n  }"
        }
      ]
    },
    {
      "id": "labels-default",
      "blockName": "labels",
      "kind": "contract",
      "statement": "Der zugängliche Standardname lautet Loading und kann über SVG-Props überschrieben werden.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/sources/shadcn/apps/v4/registry/bases/base/ui/spinner.tsx.source",
          "snippet": "role=\"status\"\n      aria-label=\"Loading\"\n      className={cn(\"size-4 animate-spin\", className)}\n      {...props}"
        }
      ]
    },
    {
      "id": "keyboard-no-listeners",
      "blockName": "keyboard",
      "kind": "contract",
      "statement": "Die Standardanzeige installiert keine Tastaturlistener oder eigene Fokusnavigation.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/accessibility.rules.json",
          "pointer": "/keyboard"
        }
      ]
    },
    {
      "id": "keyboard-host",
      "blockName": "keyboard",
      "kind": "editorial",
      "statement": "Die Sperre einer Aktion und ihr Fokus bleiben Aufgabe des Buttons und der Anwendung."
    },
    {
      "id": "semantics-status",
      "blockName": "semantics",
      "kind": "contract",
      "statement": "Die HTML-Projektion ist ein benannter Status ohne Progresswert.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/accessibility.html",
          "snippet": "role=\"status\" aria-label=\"Loading contacts\""
        }
      ]
    },
    {
      "id": "sources-limits",
      "blockName": "sources",
      "kind": "contract",
      "statement": "Der Komponenten-README begrenzt den Nachweis auf den Referenzumfang und schliesst ein allgemeines Zertifikat aus.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/spinner/README.md",
          "snippet": "`release:false`; kein allgemeines Pixel-/Framework-/AT-Zertifikat."
        }
      ]
    }
  ],
  "decisions": [
    "Kontaktladen als verständliche Wartephase ohne erfundenen Fortschritt gewählt.",
    "Sichtbarer Begleittext ist redaktionelle Komposition; kein eingebauter Spinner-Textbereich behauptet.",
    "Reduzierte Bewegung im Referenz-CSS vom Originalwrapper mit animate-spin getrennt.",
    "Alternative Komponenten sind Empfehlungen für die Auswahl, keine neue Spinner-Fähigkeit."
  ],
  "limits": [
    "Keine lokale Spinner-Demo vorhanden.",
    "Keine Prüfung einer Zielimplementierung oder ihrer Screenreader-Ausgabe ausgeführt.",
    "Statische Illustration belegt weder Bewegung noch Pixelkonformität."
  ]
}
