  "decisions": [
    "Berichtseditor als redaktionelles Beispiel mit drei klar benannten Menüs und geöffnetem Datei-Menü.",
    "Navigation Menu und Dropdown Menu als aufgabenbezogene Alternativen genannt.",
    "Standardverhalten der Base-UI-Einstellungen und fokussierbare deaktivierte Einträge ausdrücklich erklärt.",
    "Kein automatisches Tastenkürzel und keine automatische Befehlsausführung durch Hervorhebung behauptet.",
    "Orientierungsoption nicht als alleinige optische Variante beworben; Tastaturhinweise gelten ausdrücklich der üblichen horizontalen Leiste."
  ],
  "limits": [
    "Für Menubar ist keine lokale Demo unter src/demos/shadcn vorhanden.",
    "Statische Illustration ist kein Render- oder Pixelnachweis.",
    "Keine allgemeine Prüfung der eingebauten Anwendung oder assistiver Technologien durchgeführt."
  ]
}
