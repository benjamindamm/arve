      ]
    },
    {
      "id": "example-choice",
      "blockName": "example",
      "kind": "contract",
      "statement": "Die Illustration wählt Speichern, Checkbox und Löschen aus den belegten Menürollen; der sichtbare Dropdown-Zugang bietet die Einstellungen unabhängig an.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/context-menu/accessibility.rules.json",
          "pointer": "/sourceRule"
        }
      ]
    },
    {
      "id": "parts-placement",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Gruppen, Beschriftungen, Auswahlindikatoren und Untermenüs sind tatsächliche Menüteile; die Positionierung gehört zum Primitive.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/context-menu/ux.json",
          "pointer": "/visualContract/layoutPolicy"
        }
      ]
