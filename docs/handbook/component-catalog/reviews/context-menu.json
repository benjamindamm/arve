    {
      "id": "item-variants",
      "blockName": "variants",
      "kind": "contract",
      "statement": "Befehle unterstützen default/destructive und inset; Checkbox, Radio und Untermenü sind eigenständige belegte Menüteile.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/context-menu/interface.json",
