    {
      "id": "canceled-state",
      "blockName": "states",
      "kind": "contract",
      "statement": "Abgebrochene oder kontrollierte Checkbox-Änderungen überschreiben nicht selbstständig den Zustand.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/context-menu/behavior.scxml",
          "snippet": "!checkedControlled &amp;&amp; !_event.data.eventDetails.isCanceled"
        }
      ]
    },
    {
      "id": "shortcut-display",
      "blockName": "labels",
      "kind": "contract",
      "statement": "Shortcut ist nur angezeigter Text und registriert keine Tastenkombination.",
      "evidence": [
        {
