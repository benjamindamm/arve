    {
      "id": "checkbox-radio-types",
      "blockName": "variants",
      "kind": "contract",
      "statement": "Checkbox-Einträge verwenden boolean checked; Radioeinträge gehören zu einer RadioGroup.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/context-menu/interface.json",
          "pointer": "/modules/0/declarations/10/members"
        }
      ]
