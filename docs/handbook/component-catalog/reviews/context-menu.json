    {
      "id": "open-trigger",
      "blockName": "states",
      "kind": "contract",
      "statement": "Öffnung erfolgt über Kontextmenüereignis oder 500 ms langes Berühren, ohne Linksklick-Befehl; Auswahl- und Befehlsschliessung unterscheiden sich.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/context-menu/accessibility.rules.json",
          "pointer": "/sourceRule"
        }
      ]
