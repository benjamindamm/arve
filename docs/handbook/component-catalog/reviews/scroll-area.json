    {
      "id": "content-cue",
      "blockName": "labels",
      "kind": "contract",
      "statement": "Überlauf darf nicht der einzige Hinweis auf weitere Inhalte sein; die Referenz verwendet eine echte Überschrift und native Inhalte.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/scroll-area/ux.json",
