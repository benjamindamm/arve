    {
      "id": "overflow-tab-state",
      "blockName": "states",
      "kind": "contract",
      "statement": "Bei Überlauf mindestens einer Achse erhält der Viewport tabindex=0, sonst -1; native Messungen führen Position und Schiebergeometrie.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/scroll-area/accessibility.rules.json",
