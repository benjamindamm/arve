  "decisions": [
    "Native Tastaturbedienung mit konkreter Zielbrowserprüfung erklären, da das SCXML keine eigene Tastenzuordnung definiert.",
    "Projektaktivitäten als statisches Beispiel wählen; äussere Überschrift und Hinweis bleiben ausserhalb des Ausschnitts.",
    "Seitenlayout und Message Scroller als konkrete Alternativen abgrenzen; keine Varianten aus Radix annehmen."
  ],
  "limits": [
    "Keine lokale interaktive Demo für Scroll Area ausgewertet oder behauptet.",
    "SVG ist eine statische redaktionelle Illustration; keine Browser-, Pixel- oder AT-Prüfung dieser Seite."
  ]
}
