  "decisions": [
    "Geschlossene Regionsauswahl illustriert; keine plattformspezifische offene Liste als universelle Darstellung erfunden.",
    "Schweiz als in der Referenz belegte Vorbelegung gezeigt; fachliche Eignung der Vorbelegung ausdrücklich empfohlen zu prüfen.",
    "Leeroption aus gebundener Originalquelle separat erklärt, ohne sie der Regionsfixture zuzuschreiben.",
    "Auswahlalternativen und Beschriftungsempfehlungen ausdrücklich redaktionell; keine Suchfunktion oder gestaltete Mehrfachchips zugesichert."
  ],
  "limits": [
    "Keine eigene Laufzeitprüfung auf Mobilgeräten oder mit unterstützenden Technologien durchgeführt.",
    "Die SVG ist eine statische redaktionelle Illustration ohne Pixelkonformitätsanspruch."
  ]
}
