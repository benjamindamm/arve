    {
      "id": "change-controlled",
      "blockName": "states",
      "kind": "contract",
      "statement": "Nur tatsächliche native Änderungen senden onChange; kontrollierte Werte bleiben durch Vorgaben bestimmt.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/native-select/behavior.scxml",
          "snippet": "<transition event=\"NATIVE_CHANGE\" cond=\"!disabled &amp;&amp; !!_event.data.event\">\n      <send event=\"onChange\" target=\"#_parent\">\n        <param name=\"event\" expr=\"_event.data.event\" />\n      </send>\n      <if cond=\"!controlled\">\n        <assign location=\"value\" expr=\"_event.data.value\" />\n      </if>\n    </transition>"
        }
      ]
    },
