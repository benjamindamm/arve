    {
      "id": "states-escape",
      "blockName": "states",
      "kind": "contract",
      "statement": "Escape blendet den Hinweis aus und merkt sich die aktuelle Koordinate.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/chart-tooltip/behavior.scxml",
          "snippet": "<transition event=\"ESCAPE\">\n      <assign location=\"tooltipVisible\" expr=\"false\" />\n      <assign location=\"dismissedCoordinate\" expr=\"coordinateKey\" />\n    </transition>"
        }
      ]
    },
    {
      "id": "states-refresh",
      "blockName": "states",
      "kind": "contract",
      "statement": "Datenwechsel entfernt den alten Hinweis, Grafik/Tabelle/Zusammenfassung werden gemeinsam ersetzt, empty/error sind Anwendungsrückmeldungen.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/chart-tooltip/accessibility.rules.json",
