  "claims": [
    {
      "id": "usage-supplement",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Die Referenz zeigt Running/Swimming in gestapelten Balken; der Hinweis ergänzt die permanente vollständige Tabelle.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/chart-tooltip/ux.json",
          "pointer": "/purpose"
        }
      ]
    },
    {
      "id": "usage-alternative",
      "blockName": "usage",
      "kind": "editorial",
      "statement": "Allgemeiner Tooltip erklärt Bedienelemente; systematischer Datenvergleich gehört in die dauerhaft sichtbare Tabelle."
    },
    {
      "id": "example-values",
      "blockName": "example",
      "kind": "contract",
      "statement": "Sechs Datensätze; erster Tag 2024-07-15 mit running 450 und swimming 300, Einheit ausdrücklich unbekannt.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/chart-tooltip/ux.json",
          "pointer": "/exampleSource"
        }
      ]
    },
    {
      "id": "example-translation",
      "blockName": "example",
      "kind": "editorial",
      "statement": "Laufen und Schwimmen übersetzen die Reihennamen; Originaldaten und Reihenfolge bleiben erhalten."
    },
    {
      "id": "anatomy-composition",
      "blockName": "anatomy",
