  "decisions": [
    "Die sechs Originaldatensätze vollständig zeigen; Reihennamen und Datum deutsch schreiben.",
    "Unbekannte Einheit sichtbar lassen, keine Minuten oder Kalorien ableiten.",
    "Ein grösseres SVG mit vollständiger Tabelle wählen, damit die permanente Datenalternative neben dem Werthinweis sichtbar bleibt.",
    "Allgemeinen Tooltip und systematischen Tabellenvergleich als konkrete Auswahlalternativen erklären."
  ],
  "limits": [
    "Keine lokale Chart-Tooltip-Demo in src/demos/shadcn vorhanden.",
    "SVG ist eine redaktionelle Illustration; keine Laufzeit-, Pixel- oder AT-Prüfung der Zielanwendung."
  ]
}
