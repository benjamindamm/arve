  "claims": [
    {
      "id": "same-page",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Tabs wechseln zwischen zusammengehörigen Panels derselben Seite; keine aufeinanderfolgenden Aufgabenschritte.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/tabs/ux.json",
          "pointer": "/avoid"
        }
      ]
    },
    {
      "id": "related-panels",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Der fachliche Einsatz betrifft zusammengehörige Panels auf derselben Seite.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/sources/base-ui-1.9.0/docs/tabs.md.source",
          "snippet": "A component for toggling between related panels on the same page."
        }
      ]
    },
    {
      "id": "example-selection",
      "blockName": "example",
      "kind": "contract",
      "statement": "Der redaktionelle Monatsbericht überträgt die belegte manuelle Auswahl, ohne eine Live-Demo zu behaupten.",
