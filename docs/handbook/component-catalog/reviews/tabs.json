    {
      "id": "source-limits",
      "blockName": "sources",
      "kind": "contract",
      "statement": "Die Referenz bleibt horizontal und macht die nicht weitergeleitete Orientierung ausdrücklich sichtbar.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/tabs/README.md",
          "snippet": "This reference therefore does not advertise working vertical Tabs or change frozen code."
        }
      ]
    }
  ],
  "decisions": [
    "Monatsbericht als konkreter redaktioneller Einsatz mit zwei gleichrangigen Ansichten.",
    "Flächenvariante illustriert; Fokus und Auswahl im Text getrennt erklärt.",
    "Originalquellen für keepMounted-Standard und Same-page-Zweck gezielt nachgeladen.",
    "Keine pauschale Zustandserhaltung versprochen: keepMounted beschreibt DOM-Lebensdauer, Anwendungsspeicherung bleibt separat.",
    "Aktiven Snapshot gezielt gelesen; nicht als unveränderlichen historischen Beleg verwendet."
  ],
  "limits": [
    "Keine lokale Tabs-Demo vorhanden; Illustration ist statisch.",
    "Vertikale Bedienung wird wegen belegter Wrapper-Grenze nicht zugesichert.",
    "Keine Browser- oder Assistenztechnikprüfung im Rahmen dieses redaktionellen Auftrags ausgeführt."
  ]
}
