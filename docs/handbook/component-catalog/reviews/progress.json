  "decisions": [
    "Messbarer Upload als Beispiel, weil Prozentwert und physische Bezugsgrösse direkt überprüfbar sind.",
    "Spinner als redaktionelle Alternative für Warten ohne Mengenbezug benannt; keine Spinner-API aus fremden Quellen übernommen.",
    "Unbestimmtes 35%-Referenzsegment ausdrücklich von Messwert und Animation abgegrenzt.",
    "Keine lokale Live-Demo vorhanden; statische Illustration ohne Implementierungsbehauptung."
  ],
  "limits": [
    "Keine Browser- oder Screenreader-Prüfung der integrierten Seite durch diesen Auftrag.",
    "Die Illustration belegt keine Pixelkonformität; Abschluss-, Fehler- und Datenanbindung bleiben Aufgabe der Anwendung."
  ]
}
