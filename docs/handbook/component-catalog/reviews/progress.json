    },
    {
      "id": "unknown-segment",
      "blockName": "variants",
      "kind": "contract",
      "statement": "Das Referenz-CSS zeigt ein statisches mittiges 35%-Segment für unbestimmten Fortschritt; es definiert dort keine Animation.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/progress/layout.css",
          "snippet": "[data-slot=\"progress-indicator\"][data-indeterminate] {\n  inline-size: 35%;\n  margin-inline: auto;\n}"
        }
      ]
    },
    {
      "id": "derived-states",
      "blockName": "states",
      "kind": "contract",
      "statement": "Null oder nicht endliche Werte bleiben unbestimmt, endliche Werte werden geklemmt; am Maximum wird der Zustand vollständig.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/progress/behavior.scxml",
          "snippet": "<assign location=\"status\" expr=\"normalized === null ? 'indeterminate' : normalized === max ? 'complete' : 'progressing'\" />"
        }
      ]
    },
    {
      "id": "caller-feedback",
      "blockName": "states",
      "kind": "contract",
      "statement": "Die Anwendung liefert Werte und Abschluss-/Fehlermeldungen; Progress hat keinen Timer, Request, Abbruch oder onValueChange.",
