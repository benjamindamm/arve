          "pointer": "/avoid"
        }
      ]
    },
    {
      "id": "upload-example",
      "blockName": "example",
      "kind": "editorial",
      "statement": "Der Entwurf verwendet 8 von 20 MB und 40 Prozent konsistent; weitere Verarbeitung wird als eigener Schritt empfohlen.",
      "evidence": []
    },
    {
      "id": "automatic-track",
