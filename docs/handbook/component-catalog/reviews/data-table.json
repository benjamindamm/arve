  "decisions": [
    "Zahlungen mit US-Dollar als nahes fachliches Beispiel beibehalten, deutsche E-Mail-Adressen und Statuswörter redaktionell gewählt.",
    "Breite Illustration mit expliziter Mindestbreite statt verkleinerter unlesbarer Tabelle.",
    "Keine globale Suche, allgemeine Grid-Navigation oder Dashboard-Funktionen dem Bauplan zugeschrieben.",
    "Seitenweite und gefilterte Gesamtauswahl in der Redaktion ausdrücklich unterschieden."
  ],
  "limits": [
    "Keine lokale Data-Table-Demo in src/demos/shadcn gefunden.",
    "Statische SVG ist eine redaktionelle Illustration und kein Rendernachweis.",
    "Kein aktueller Browser- oder Screenreader-Nachweis für eine integrierte Data Table erbracht."
  ]
