  "decisions": [
    "Die optionale Linkvorschau wird ausdrücklich von Tooltip und Popover abgegrenzt.",
    "Die Touch-Alternative ist das normale vollständige Linkziel; kein erfundener Tap-Modus.",
    "Zeitwerte stammen aus der Base-UI-gebundenen Referenz, nicht aus Radix-Annahmen.",
    "Das SVG zeigt eine einzelne offene Profilvorschau ohne zusätzliche Aktion im Inhalt."
  ],
  "limits": [
    "Die Illustration und HTML-Fixtures sind statisch; keine neue Laufzeit-, Fokus- oder Assistenztechnikprüfung.",
    "Kein allgemeiner Framework- oder Plattformnachweis; das Paket beschreibt die gebundene React-Variante."
  ]
}
