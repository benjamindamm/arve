  "claims": [
    {
      "id": "purpose-count",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Die Referenz vergleicht Zählwerte als radiale Balken und ist nicht automatisch eine Fortschrittsanzeige.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/chart-radial/ux.json",
