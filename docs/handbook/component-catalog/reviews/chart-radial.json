    {
      "id": "choose-bar",
      "blockName": "usage",
      "kind": "editorial",
      "statement": "Für präzise Rangfolgen wird Chart Bar, für belegte Zielerreichung Progress empfohlen."
    },
    {
      "id": "scale-example",
      "blockName": "example",
      "kind": "editorial",
      "statement": "Kanalnamen, Berichtsmonat und Skalenmaximum 300 sind redaktionell; alle Winkel sind proportional zum Wert und keine Anteile an der Summe."
