          "pointer": "/purpose"
        }
      ]
    },
    {
      "id": "example-path",
      "blockName": "example",
      "kind": "editorial",
      "statement": "Der Entwurf verwendet einen vollständigen Pfad mit zwei Vorfahren und aktueller Seite; Namen und Platzierung sind redaktionell."
    },
    {
      "id": "anatomy",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Navigation, Liste, Eintrag, Vorfahrenlink, aktuelle Seite, Trenner und Auslassung sind die sieben gebundenen Teile.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/breadcrumb/component.json",
          "pointer": "/anatomy"
