  "decisions": [
    "Vollständigen kurzen Projektpfad illustriert, um Auslassung nicht als automatisches Menü erscheinen zu lassen.",
    "Alternativen für Besuchsverlauf und Hauptbereiche als redaktionelle Auswahlhilfe benannt.",
    "Quellstand der nicht fokussierbaren aktuellen Seite mit Linkrolle ausdrücklich bewahrt."
  ],
  "limits": [
    "Keine lokale Breadcrumb-Demo im Verzeichnis src/demos/shadcn gefunden.",
    "Die Illustration ist redaktionell und statisch; die Prüfung in der integrierten Anwendung bleibt offen."
  ]
}
