    {
      "id": "hover-focus",
      "blockName": "states",
      "kind": "contract",
      "statement": "Hover färbt und unterstreicht Vorfahrenlinks; focus-visible zeichnet eine Kontur.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/breadcrumb/layout.css",
          "snippet": "[data-slot=\"breadcrumb-link\"]:hover {\n  color: var(--ui-color-foreground);\n  text-decoration: underline;\n}"
        },
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/breadcrumb/layout.css",
          "snippet": "[data-slot=\"breadcrumb-link\"]:focus-visible {\n  outline: var(--ui-focus-width) solid var(--ui-color-ring);\n  outline-offset: var(--ui-focus-width);\n}"
        }
      ]
    },
    {
      "id": "navigation",
      "blockName": "states",
      "kind": "contract",
      "statement": "Native Navigation erfolgt nach LINK_CLICK, sofern das ursprüngliche Ereignis nicht verhindert wurde.",
