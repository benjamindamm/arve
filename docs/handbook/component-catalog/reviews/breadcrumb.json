  "claims": [
    {
      "id": "hierarchy-not-history",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Breadcrumb zeigt eine Inhaltshierarchie mit echten Links zu Vorfahren, keinen Besuchsverlauf.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/breadcrumb/ux.json",
