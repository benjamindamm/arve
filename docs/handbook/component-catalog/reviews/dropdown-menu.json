  "decisions": [
    "Berichtaktionen als konkreter Kontext statt einer technischen Aufzählung verwendet.",
    "Select und Navigation als benannte Alternativen abgegrenzt.",
    "Checkbox und Radio bewusst als Menüeinstellungen mit anderem Standardschliessen erläutert.",
    "Kompakte statische SVG mit grösserer Höhe für klar getrennte Befehls- und Einstellungsgruppen erstellt."
  ],
  "limits": [
    "Keine lokale Dropdown-Menu-Demo unter src/demos/shadcn vorhanden.",
    "Keine Browser- oder assistive Technik-Prüfung dieser redaktionellen Seite durchgeführt."
  ]
}
