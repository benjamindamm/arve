          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/dropdown-menu/behavior.scxml",
          "snippet": "<param name=\"policy\" expr=\"'actual-owner-reason-and-finalFocus-prop'\" />"
        }
      ]
    },
    {
      "id": "source-limits",
      "blockName": "sources",
      "kind": "contract",
      "statement": "Der Referenzabschluss ist begrenzt und keine allgemeine Anwendungsfreigabe.",
