  "claims": [
    {
      "id": "supplementary-only",
      "blockName": "usage",
      "kind": "contract",
      "statement": "Collapsible zeigt ergänzende Inhalte; wesentliche Aufgabenhinweise sollen nicht darin verborgen werden.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/ux.json",
          "pointer": "/avoid"
        }
      ]
    },
    {
      "id": "accordion-choice",
      "blockName": "usage",
      "kind": "editorial",
      "statement": "Für mehrere gleichrangige zusammengehörige Abschnitte wird redaktionell Accordion empfohlen."
    },
    {
      "id": "project-example",
      "blockName": "example",
      "kind": "editorial",
      "statement": "Projektübersicht und Beispielrahmen sind redaktionelle Illustration, keine Contractvariante."
    },
    {
      "id": "three-parts",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Container, nativer Auslöser und Inhaltsbereich sind die drei zugeordneten Teile.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/component.json",
          "pointer": "/anatomy"
        }
      ]
    },
    {
      "id": "reference-spacing",
      "blockName": "anatomy",
      "kind": "contract",
      "statement": "Die Referenz beschreibt 32px Header, 16px seitlichen Innenabstand und 8px Stapelabstand.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/component.json",
          "pointer": "/visualContract/layoutPolicy"
        }
      ]
    },
    {
      "id": "no-visual-variants",
      "blockName": "variants",
      "kind": "contract",
      "statement": "Keine eigenen visuellen Varianten; Karte, Pfeil und Animation werden nicht zugesichert.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/component.json",
          "pointer": "/visualContract"
        }
      ]
    },
    {
      "id": "panel-options",
      "blockName": "variants",
      "kind": "contract",
      "statement": "keepMounted erhält verborgenen Inhalt; hiddenUntilFound erhält und durchsucht ihn in unterstützenden Browsern.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/sources/base-ui-1.9.0/docs/collapsible.md.source",
          "snippet": "The `hiddenUntilFound` prop hides the closed panel"
        }
      ]
    },
    {
      "id": "search-fallback",
      "blockName": "variants",
      "kind": "contract",
      "statement": "Ältere Browser überspringen den Inhalt bei der Seitensuche.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/sources/base-ui-1.9.0/docs/collapsible.md.source",
          "snippet": "Older browsers that don't support `hidden=\"until-found\"` keep the panel hidden until its trigger opens it, and find-in-page skips over the contents."
        }
      ]
    },
    {
      "id": "state-controls",
      "blockName": "states",
      "kind": "contract",
      "statement": "open/defaultOpen steuern ein Panel, disabled verhindert Umschalten; onOpenChange ist abbrechbar.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/ux.json",
          "pointer": "/sourceRule"
        }
      ]
    },
    {
      "id": "closed-content",
      "blockName": "states",
      "kind": "contract",
      "statement": "Geschlossener Inhalt ist standardmässig entfernt oder bei keepMounted verborgen und nicht interaktiv.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/accessibility.rules.json",
          "pointer": "/closedProjection"
        }
      ]
    },
    {
      "id": "state-visual-feedback",
      "blockName": "states",
      "kind": "contract",
      "statement": "Hover, Fokusmarkierung und reduzierte Deckkraft sind CSS-Rückmeldungen.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/layout.css",
          "snippet": "[data-slot=\"collapsible-trigger\"]:disabled {\n  opacity: 0.5;\n}"
        }
      ]
    },
    {
      "id": "topic-label",
      "blockName": "labels",
      "kind": "editorial",
      "statement": "Konkrete Themennamen und sichtbar erklärte Nichtverfügbarkeit sind redaktionelle Empfehlungen."
    },
    {
      "id": "keyboard-native",
      "blockName": "keyboard",
      "kind": "contract",
      "statement": "Native Enter-/Leertaste und Tab; kein Schliessen durch Escape/Aussenklick, keine Fokusfalle oder automatische Fokusrückgabe.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/ux.json",
          "pointer": "/keyboardAndFocus"
        }
      ]
    },
    {
      "id": "programmatic-focus",
      "blockName": "keyboard",
      "kind": "contract",
      "statement": "Vor programmgesteuertem Verbergen fokussierter Kinder verantwortet der Aufrufer nötige Fokuswiederherstellung.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/ux.json",
          "pointer": "/sourceRule"
        }
      ]
    },
    {
      "id": "button-semantics",
      "blockName": "semantics",
      "kind": "contract",
      "statement": "Die HTML-Referenz nutzt type=button, aria-expanded und aria-controls zum vorhandenen Panel.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/accessibility.html",
          "snippet": "<button type=\"button\" data-slot=\"collapsible-trigger\" aria-expanded=\"true\" aria-controls=\"details\">Project details</button>"
        }
      ]
    },
    {
      "id": "form-errors",
      "blockName": "semantics",
      "kind": "editorial",
      "statement": "Fehler in verborgenen Formularfeldern sichtbar und erreichbar zu machen ist eine Empfehlung an die Anwendung."
    },
    {
      "id": "bounded-evidence",
      "blockName": "sources",
      "kind": "contract",
      "statement": "complete beschreibt den begrenzten Quellenumfang und keine allgemeine Anwendungs- oder Plattformzertifizierung.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/components/collapsible/ux.json",
          "pointer": "/referenceDecisions"
        }
      ]
    }
  ],
  "decisions": [
    "Einzelne optionale Projektdetails als Beispiel; Pflichtinformationen bleiben sichtbar.",
    "Accordion-Vergleich ist eine redaktionelle Auswahlhilfe, keine aus fremden Komponenten übernommene Verhaltensregel.",
    "keepMounted und hiddenUntilFound als belegte Integrationsentscheidungen statt erfundener Designvarianten erläutert.",
    "Keine pauschale Modalitätsaussage aus dem generischen actualModalityProjection-Feld übernommen; komponentenspezifische keyboardAndFocus-Regel führt."
  ],
  "limits": [
    "Keine lokale Collapsible-Demo unter src/demos/shadcn vorhanden.",
    "SVG zeigt keine Laufzeitinteraktion; konkrete Formular- und Fokusintegration bleibt in der Anwendung zu prüfen."
  ]
}
