  "decisions": [
    "Gebundene sechs Monatswerte unverändert übernommen und Monatsnamen deutsch ausgeschrieben; kein unbelegtes Jahr ergänzt.",
    "Lineare Skala ab null und gleich breite Balken zeigen Mengen ohne überzeichnete Differenzen.",
    "Ein einzelner Datensatz benötigt keine zusätzliche Farbkodierung; Titel und Tabellenkopf benennen Desktop.",
    "Illustration zeigt die vollständige Tabelle statt eines ausschliesslich per Hover verfügbaren Wertes.",
    "Diagrammfamilien nicht aus allgemeinen Recharts-Fähigkeiten abgeleitet; nur belegte Tooltip- und Theme-Optionen beschrieben."
  ],
  "limits": [
    "Keine produktive Chart-Bar-Implementierung in Arve nachgewiesen.",
    "Statische Illustration ist kein Nachweis für Pixelkonformität oder Laufzeitverhalten.",
    "Gebundene Daten nennen kein Jahr; Aussagen zu Ursachen und längeren Trends sind daraus nicht ableitbar."
  ]
}
