    {
      "id": "modality-close-requirement",
      "blockName": "variants",
      "kind": "contract",
      "statement": "modal=true aktiviert Fokusfang nur mit Popover.Close im Popup; trap-focus verlangt Close für Touch-Screenreader.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/sources/base-ui-1.9.0/docs/popover.md.source",
          "snippet": "When `modal` is `true`, focus trapping is enabled only if `<Popover.Close>` is rendered&#xA;inside `<Popover.Popup>`."
        }
      ]
    },
    {
      "id": "trap-focus-close",
      "blockName": "variants",
      "kind": "contract",
      "statement": "trap-focus verlangt innenliegendes Close für Touch-Screenreader.",
      "evidence": [
        {
          "path": "src/contracts/libraries/shadcn/30c4964806cddb026155c6d3126dbe8251b34c34f81640b07b0d59b916343c90/package/library/sources/base-ui-1.9.0/docs/popover.md.source",
          "snippet": "When `modal` is `'trap-focus'`, render `<Popover.Close>` inside `<Popover.Popup>` so touch&#xA;screen readers can escape the popup."
        }
      ]
    },
